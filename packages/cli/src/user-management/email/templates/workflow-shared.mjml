<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="400">ワークフローが共有されました</mj-text>
				<mj-text>ワークフロー <b>「{{ workflowName }}」</b> があなたに共有されました。</mj-text>
				<mj-text>アクセスするには、下のボタンをクリックしてください。</mj-text>
				<mj-button href="{{workflowUrl}}">ワークフローを開く</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
