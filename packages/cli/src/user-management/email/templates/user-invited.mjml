<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="400">n8n へようこそ！🎉</mj-text>
				<mj-text><b>{{domain}}</b> の n8n に招待されました。</mj-text>
				<mj-text>参加するには、下のボタンをクリックしてください。</mj-text>
				<mj-button href="{{inviteAcceptUrl}}">n8n アカウントを設定する</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
