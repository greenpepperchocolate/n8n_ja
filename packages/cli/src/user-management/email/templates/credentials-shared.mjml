<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="400">認証情報が共有されました</mj-text>
				<mj-text>認証情報 <b>「{{ credentialsName }}」</b> があなたに共有されました。</mj-text>
				<mj-text>アクセスするには、下のボタンをクリックしてください。</mj-text>
				<mj-button href="{{credentialsListUrl}}">認証情報を開く</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
