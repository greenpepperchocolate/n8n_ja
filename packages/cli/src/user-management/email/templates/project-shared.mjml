<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="400">
					<b>{{ projectName }}</b> プロジェクトに{{ role }}として追加されました
				</mj-text>
				<mj-text>これにより、このプロジェクト内のすべてのワークフローと認証情報にアクセスできます。</mj-text>
				<mj-button href="{{projectUrl}}">プロジェクトを表示</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
